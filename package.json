{
  "name": "grudge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "probe": "tsx --conditions=react-server --env-file=.env.local scripts/probe.ts",
    "agent": "tsx --conditions=react-server --env-file=.env.local scripts/agent.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server --env-file=.env.local scripts/migrate.ts"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@mysten-incubation/memwal": "0.1.13",
    "@mysten/deepbook-v3": "2.11.1",
    "@mysten/seal": "^1.5.3",
    "@mysten/sui": "2.39.1",
    "@protobuf-ts/grpc-transport": "^2.11.1",
    "@protobuf-ts/runtime-rpc": "^2.11.1",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.5",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  }
}
