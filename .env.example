# Grudge environment. Copy to .env and fill in. Scripts and Next.js both read it. Never commit .env.

# Supabase session pooler URI (IPv4, port 5432), project in eu-central-1
DATABASE_URL=

# dashboard.tatum.io
TATUM_API_KEY=

# memory.walrus.xyz/dashboard: delegate private key, and the MemWalAccount object id (NOT the wallet address)
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Receives x402 USDC. The server holds no key for it.
TREASURY_ADDRESS=
# 32+ random bytes, signs x402 quotes
QUOTE_SECRET=
# https://grudge.onrender.com in production
PUBLIC_BASE_URL=http://localhost:3000

# Protects POST /api/admin/amnesia
ADMIN_TOKEN=

LIVE_REFRESH_MS=15000
IDLE_REFRESH_MS=60000

# scripts/agent.ts only. Payer with about 1 USDC, no SUI needed. Never set on the server.
AGENT_PRIVATE_KEY=
